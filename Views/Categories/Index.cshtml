@model IReadOnlyList<Category>
@{
    ViewData["Title"] = "Categories";
}
<div class="page-heading"><div><div class="eyebrow">COLLECTION</div><h1>Categories</h1><p class="text-secondary mb-0">Organize the collection into easy-to-browse groups.</p></div><a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-2"></i>Add category</a></div>
<div class="content-card">
    @if (Model.Count == 0) { <div class="empty-inline">No categories yet. Create a category before adding books.</div> }
    else { <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Category</th><th>Description</th><th>Books</th><th></th></tr></thead><tbody>@foreach(var c in Model){<tr><td class="fw-semibold">@c.Name</td><td>@(c.Description ?? "—")</td><td>@c.Books.Count</td><td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@c.Id">Edit</a><form class="d-inline" asp-action="Delete" asp-route-id="@c.Id" method="post" data-confirm="Delete category @c.Name?"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>}</tbody></table></div> }
</div>
