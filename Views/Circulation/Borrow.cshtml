@model BorrowInput
@{
    ViewData["Title"] = "Record a borrow";
}
<div class="page-heading"><div><div class="eyebrow">CIRCULATION</div><h1>Record a borrow</h1><p class="text-secondary mb-0">Inventory is updated only after the borrowing transaction succeeds.</p></div><a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div>
<div class="content-card"><form asp-action="Borrow" method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="row g-3">
    <div class="col-md-6"><label asp-for="MemberId" class="form-label">Active member</label><select asp-for="MemberId" class="form-select"><option value="">Select a member</option>@foreach(Member m in ViewBag.Members){<option value="@m.Id">@m.MemberCode · @m.FullName</option>}</select><span asp-validation-for="MemberId" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="BookId" class="form-label">Available book</label><select asp-for="BookId" class="form-select"><option value="">Select a book</option>@foreach(Book b in ViewBag.Books){<option value="@b.Id">@b.Title · @b.AvailableCopies available</option>}</select><span asp-validation-for="BookId" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="Quantity" class="form-label"></label><input asp-for="Quantity" class="form-control" min="1" type="number" /><span asp-validation-for="Quantity" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="BorrowDate" class="form-label">Borrow date</label><input asp-for="BorrowDate" class="form-control" type="date" /><span asp-validation-for="BorrowDate" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="DueDate" class="form-label">Due date</label><input asp-for="DueDate" class="form-control" type="date" /><span asp-validation-for="DueDate" class="text-danger"></span></div>
    <div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control"></textarea></div>
    </div><button class="btn btn-primary mt-4">Save borrowing transaction</button></form></div>
