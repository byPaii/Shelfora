@model IReadOnlyList<BorrowTransaction>
@{
    ViewData["Title"] = "Borrowing";
    var page=(int)ViewBag.Page; var pages=(int)ViewBag.TotalPages;
}
<div class="page-heading"><div><div class="eyebrow">CIRCULATION</div><h1>Borrowing</h1><p class="text-secondary mb-0">Track open loans, completed returns, and due dates.</p></div><a class="btn btn-primary" asp-action="Borrow"><i class="bi bi-plus-lg me-2"></i>Record a borrow</a></div>
<div class="content-card"><form class="toolbar" method="get"><input class="form-control" name="q" value="@ViewBag.Query" placeholder="Search member, book or transaction" aria-label="Search transactions" /><select name="status" class="form-select" aria-label="Filter transactions"><option value="">All transactions</option><option value="active" selected="@(ViewBag.Status == "active")">Active</option><option value="overdue" selected="@(ViewBag.Status == "overdue")">Overdue</option><option value="completed" selected="@(ViewBag.Status == "completed")">Completed</option></select><select name="sort" class="form-select" aria-label="Sort transactions"><option value="">Newest</option><option value="due" selected="@(ViewBag.Sort == "due")">Due date</option></select><button class="btn btn-outline-secondary">Filter</button><a asp-action="Overdue" class="btn btn-outline-danger ms-auto">Overdue list</a></form>
    @if(Model.Count==0){<div class="empty-inline">No borrowing records match this filter.</div>}
    else{<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Transaction</th><th>Member</th><th>Book</th><th>Borrow date</th><th>Due date</th><th>Outstanding</th><th>Status</th></tr></thead><tbody>@foreach(var t in Model){var overdue=t.IsOverdue(DateTime.Today);<tr><td><a asp-action="Details" asp-route-id="@t.Id">@t.TransactionCode</a></td><td>@t.Member?.FullName</td><td>@t.Book?.Title</td><td>@t.BorrowDate.ToString("d")</td><td>@t.DueDate.ToString("d")</td><td>@t.Outstanding</td><td><span class="badge @(overdue?"text-bg-danger":t.Status==BorrowStatus.Completed?"text-bg-secondary":"text-bg-primary")">@(overdue?"Overdue":t.Status)</span></td></tr>}</tbody></table></div>}
    @if(pages>1){<nav class="mt-3"><ul class="pagination pagination-sm">@for(var p=1;p<=pages;p++){<li class="page-item @(p==page?"active":"")"><a class="page-link" asp-route-page="@p" asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="@ViewBag.Sort">@p</a></li>}</ul></nav>}
</div>
