@model BorrowTransaction
@{
    ViewData["Title"] = "Transaction details";
    var overdue=Model.IsOverdue(DateTime.Today);
}
<div class="page-heading"><div><div class="eyebrow">CIRCULATION / @Model.TransactionCode</div><h1>Borrowing details</h1><p class="text-secondary mb-0">@Model.Member?.FullName · @Model.Book?.Title</p></div><a class="btn btn-outline-secondary" asp-action="Index">Back to borrowing</a></div>
<div class="content-card mb-3"><div class="detail-grid"><div class="detail-item"><small>Book</small>@Model.Book?.Title</div><div class="detail-item"><small>Member</small>@Model.Member?.FullName</div><div class="detail-item"><small>Status</small>@(overdue?"Overdue":Model.Status.ToString())</div><div class="detail-item"><small>Borrowed</small>@Model.BorrowDate.ToString("d")</div><div class="detail-item"><small>Due date</small>@Model.DueDate.ToString("d")</div><div class="detail-item"><small>Quantity</small>@Model.Quantity (@Model.Outstanding outstanding)</div></div>
    @if(!string.IsNullOrWhiteSpace(Model.Notes)){<p class="mt-3 mb-0">@Model.Notes</p>}
</div>
@if(Model.Outstanding>0){<div class="content-card mb-3"><h2 class="h6 mb-3">Record a return</h2><form asp-action="Return" asp-route-id="@Model.Id" method="post"><input type="hidden" name="SubmissionToken" value="@Guid.NewGuid().ToString("N")" /><div class="row g-2 align-items-end"><div class="col-sm-3"><label for="Quantity" class="form-label">Quantity (up to @Model.Outstanding)</label><input id="Quantity" name="Quantity" class="form-control" type="number" min="1" max="@Model.Outstanding" value="1" required /></div><div class="col-sm-6"><label for="Notes" class="form-label">Return notes (optional)</label><input id="Notes" name="Notes" class="form-control" maxlength="500" /></div><div class="col-sm-3"><button class="btn btn-primary w-100">Save return</button></div></div></form></div>}
<div class="content-card"><div class="panel-heading"><h2 class="h6">Return history</h2></div>@if(Model.Returns.Count==0){<div class="empty-inline">No return events recorded.</div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Returned at (UTC)</th><th>Quantity</th><th>Notes</th></tr></thead><tbody>@foreach(var r in Model.Returns.OrderByDescending(x=>x.ReturnedAtUtc)){<tr><td>@r.ReturnedAtUtc.ToString("g")</td><td>@r.Quantity</td><td>@(r.Notes ?? "—")</td></tr>}</tbody></table></div>}</div>
