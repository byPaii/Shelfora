@model IReadOnlyList<OverdueItem>
@{
    ViewData["Title"] = "Overdue loans";
}
<div class="page-heading"><div><div class="eyebrow">CIRCULATION</div><h1>Overdue loans</h1><p class="text-secondary mb-0">Calculated from due dates and outstanding copies. Fines are estimates only.</p></div><a class="btn btn-outline-secondary" asp-action="Index">All transactions</a></div>
<div class="content-card">@if(Model.Count==0){<div class="empty-inline">No overdue loans. Everything is up to date.</div>}else{<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Transaction</th><th>Member</th><th>Book</th><th>Borrowed</th><th>Due</th><th>Outstanding</th><th>Days overdue</th><th>Estimated fine</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><a asp-action="Details" asp-route-id="@x.Transaction.Id">@x.Transaction.TransactionCode</a></td><td>@x.Transaction.Member?.FullName</td><td>@x.Transaction.Book?.Title</td><td>@x.Transaction.BorrowDate.ToString("d")</td><td>@x.Transaction.DueDate.ToString("d")</td><td>@x.Transaction.Outstanding</td><td>@x.DaysOverdue</td><td>@x.EstimatedFine.ToString("0.00")</td></tr>}</tbody></table></div><p class="small text-secondary mt-3 mb-0">Estimated fine units = overdue days × outstanding quantity × configured daily rate.</p>}</div>
