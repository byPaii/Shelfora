@model Book
@{
    ViewData["Title"] = "Book details";
}
<div class="page-heading"><div><div class="eyebrow">COLLECTION / @Model.BookCode</div><h1>@Model.Title</h1><p class="text-secondary mb-0">@Model.Author</p></div><div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil me-1"></i>Edit</a><a class="btn btn-outline-secondary" asp-action="Index">Back</a></div></div>
<div class="content-card mb-3"><div class="detail-grid">
    <div class="detail-item"><small>Category</small>@Model.Category?.Name</div><div class="detail-item"><small>ISBN</small>@(Model.Isbn ?? "—")</div><div class="detail-item"><small>Publisher</small>@(Model.Publisher ?? "—")</div>
    <div class="detail-item"><small>Publication year</small>@(Model.PublicationYear?.ToString() ?? "—")</div><div class="detail-item"><small>Shelf location</small>@(Model.ShelfLocation ?? "—")</div><div class="detail-item"><small>Copies available</small>@Model.AvailableCopies / @Model.TotalCopies</div>
</div>@if (!string.IsNullOrWhiteSpace(Model.Description)) { <p class="mt-3 mb-0">@Model.Description</p> }</div>
<div class="content-card"><div class="panel-heading"><h2 class="h6">Borrowing history</h2></div>
    @if (Model.Transactions.Count == 0) { <div class="empty-inline">No borrowing history yet.</div> }
    else { <div class="table-responsive"><table class="table"><thead><tr><th>Transaction</th><th>Member</th><th>Borrowed</th><th>Due</th><th>Status</th></tr></thead><tbody>@foreach(var t in Model.Transactions.OrderByDescending(x=>x.BorrowDate)){<tr><td><a asp-controller="Circulation" asp-action="Details" asp-route-id="@t.Id">@t.TransactionCode</a></td><td>@t.Member?.FullName</td><td>@t.BorrowDate.ToString("d")</td><td>@t.DueDate.ToString("d")</td><td>@t.Status</td></tr>}</tbody></table></div> }
</div>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-confirm="Delete this book? This cannot be undone." class="mt-3"><button class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete book</button></form>
