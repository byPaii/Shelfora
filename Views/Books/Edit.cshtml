@model Book
@{
    ViewData["Title"] = "Edit book";
}
<div class="page-heading"><div><div class="eyebrow">COLLECTION</div><h1>Edit book</h1></div><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a></div>
<div class="content-card"><form asp-action="Edit" asp-route-id="@Model.Id" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><partial name="_Form" model="Model" /><p class="small text-secondary mt-3 mb-0">Available copies are adjusted from the number of active loans and cannot be edited directly.</p><div class="mt-4"><button class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Save changes</button></div></form></div>
