@model IReadOnlyList<Member>
@{
    ViewData["Title"] = "Members";
    var page = (int)ViewBag.Page;
    var pages = (int)ViewBag.TotalPages;
}
<div class="page-heading"><div><div class="eyebrow">PEOPLE</div><h1>Members</h1><p class="text-secondary mb-0">Manage membership details and borrowing eligibility.</p></div><a class="btn btn-primary" asp-action="Create"><i class="bi bi-person-plus me-2"></i>Register member</a></div>
<div class="content-card">
    <form class="toolbar" method="get"><input class="form-control" name="q" value="@ViewBag.Query" placeholder="Search name, member ID or email" aria-label="Search members" /><select class="form-select" name="status" aria-label="Filter membership"><option value="">All members</option><option value="active" selected="@(ViewBag.Status == "active")">Active</option><option value="inactive" selected="@(ViewBag.Status == "inactive")">Inactive</option></select><select class="form-select" name="sort" aria-label="Sort members"><option value="">Name A–Z</option><option value="date" selected="@(ViewBag.Sort == "date")">Newest members</option><option value="code" selected="@(ViewBag.Sort == "code")">Member ID</option></select><button class="btn btn-outline-secondary">Filter</button></form>
    @if (Model.Count == 0) { <div class="empty-inline">No members found.</div> }
    else { <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Member</th><th>Member ID</th><th>Contact</th><th>Member since</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var m in Model){<tr><td><a asp-action="Details" asp-route-id="@m.Id">@m.FullName</a></td><td>@m.MemberCode</td><td>@(m.Email ?? m.ContactNumber ?? "—")</td><td>@m.MembershipDate.ToString("d")</td><td><span class="badge @(m.IsActive ? "text-bg-success" : "text-bg-secondary")">@(m.IsActive ? "Active" : "Inactive")</span></td><td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@m.Id">Edit</a></td></tr>}</tbody></table></div> }
    @if (pages > 1) { <nav class="mt-3" aria-label="Member pages"><ul class="pagination pagination-sm">@for (var p=1;p<=pages;p++){<li class="page-item @(p==page?"active":"")"><a class="page-link" asp-route-page="@p" asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="@ViewBag.Sort">@p</a></li>}</ul></nav> }
</div>
