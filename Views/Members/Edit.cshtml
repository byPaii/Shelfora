@model Member
@{
    ViewData["Title"] = "Edit member";
}
<div class="page-heading"><div><div class="eyebrow">PEOPLE</div><h1>Edit member</h1></div><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a></div>
<div class="content-card"><form asp-action="Edit" asp-route-id="@Model.Id" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><partial name="_Form" model="Model" /><button class="btn btn-primary mt-4">Save changes</button></form></div>
